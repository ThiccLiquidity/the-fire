# Copy to .env (never commit .env). Addresses on Robinhood Chain (4663); see docs/addresses.md and docs/deploy.md.
# Keys never go here: sign with --account deployer (Foundry keystore) or --ledger.
RPC=

# Step 1: PlankUsdTwap
PLANK_WETH_V2_PAIR=0x01b1BEf6fBA02c846eA5c4Ff59193988B5f86F73
PLANK=0x69420eaf0eBF43E08F621B014f25cEfDfA7e2DDc
ETH_USD_FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9

# Step 2: adapter + Fire
PAPER=
MILL=0x8DaA534c13C8b6164D73163F521fE3c94889dFC9
ROYALTY_POOL=0x85715BbE2707476294B0c20B7DfbE32cCcADD0E1
PLANK_USD_FEED=
# USDG on Robinhood Chain (6 decimals): the currency mill listings are priced in on OpenSea
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Seaport 1.6, confirmed deployed on Robinhood Chain (Sep 27 2026). Unset disables mill buying for good, and ETH from
# ETH tickets would then stay in the Fire forever — don't deploy without it.
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395
PAPER_PER_TICKET=1000000000000000000
# The PAPER part of a ticket never costs more than this (USD, 8 decimals): above it, tickets take less than 1 PAPER
PAPER_USD_CAP=33000000
UNIV2_FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Launch day, after the PLANK feed's first checkpoint: leave blank and dry-run the deploy (no --broadcast); it stops
# and prints the number to put here (~$0.90 of PLANK in wei).
PLANK_PER_TICKET0=
PLANK_USD_PER_TICKET=90000000
ETH_USD_PER_TICKET=100000000
# Starting mill bid in USD, 8 decimals (50000000000 = $500). Climbs 25% of the start per day (linear, at most 3x, never past what the fund holds) until a mill sells.
MILL_BID_BASE=
ROLL_TIME_OF_DAY=75600
# PLANK (wei) from the deployer into fire #1's pot at deploy (e.g. $250 of PLANK). Deployer-only, once, before the
# first storm. Required: the deploy refuses to run without it unless NO_SEED=true (then seed later by hand with
# approve + Fire.seed(amount)).
SEED_PLANK=
# NO_SEED=true
