# Copy to .env (never commit .env). Addresses on Robinhood Chain (4663); see docs/addresses.md and docs/deploy.md.
# Keys never go here: the deployer signs with --account deployer (Foundry keystore), the owner on its hardware wallet
# (--ledger or --trezor).
# For the shell only: the scripts don't read it; pass the RPC with --rpc-url (docs/deploy.md sets $env:RPC).
RPC=
# For the shell only (keep the double quotes, or forge can't read this file): the owner's Ledger account path
# (Ledger Live account N = m/44'/60'/N'/0/0). Check it with
# cast wallet address --ledger --hd-path "<path>"; owner commands pass it as --hd-paths (docs/deploy.md).
OWNER_HD_PATH="m/44'/60'/1'/0/0"

# Step 1: PlankUsdTwap (script/DeployTwap.s.sol)
PLANK_WETH_V2_PAIR=0x01b1BEf6fBA02c846eA5c4Ff59193988B5f86F73
PLANK=0x69420eaf0eBF43E08F621B014f25cEfDfA7e2DDc
ETH_USD_FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9

# Step 2: OpenDrandRouter + PaperUsdTwap (script/DeployInfra.s.sol)
PAPER=0x06420168Ed7e368dd8dcB30C79CdD0D8F4ccb3e6
# USDG on Robinhood Chain (6 decimals)
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
UNIV2_FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Step 3: card contracts (script/DeployCards.s.sol, see docs/cards-contracts.md and docs/omni-economy.md)
# Also uses PAPER, PLANK, USDG, WETH and ETH_USD_FEED from above.
# The Paper Press NFT (starter packs)
MILL=0x8DaA534c13C8b6164D73163F521fE3c94889dFC9
# The PlankUsdTwap from step 1, the OpenDrandRouter and PaperUsdTwap from step 2: read from deployments/<chainId>.json
# (the scripts write it) when left empty; set them here only to override.
# The PlankUsdTwap from step 1
PLANK_USD_FEED=
# The OpenDrandRouter from step 2 (no owner)
DRAND_ROUTER=
# The PaperUsdTwap from step 2 (never the PAPER pool itself); required. It reports a price ~40h after its first
# checkpoint, once a PAPER pool holds >= $10 on its dollar side and >= 1,000 PAPER; until then packs take the set PAPER (no dollar ceiling)
# and case and grading fees wait in PaperBurner.
PAPER_USD_FEED=
# The hardware wallet (Ledger or Trezor) that owns everything; not the deployer. After the deploy it accepts seven
# contracts in one run of script/AcceptOwnership.s.sol: FirePacks, FireCards, RecipeDealer, FireCredits, FireSale,
# FirePsa and PaperBurner (until then the deployer holds them, so a mistyped OWNER owns nothing). PlankBurner has no
# owner. Then check with script/VerifyDeploy.s.sol.
OWNER=
# Where resale royalties go, and how much (500 = 5%, max 1000)
ROYALTY_RECEIVER=
ROYALTY_BPS=500
# Folder of the pack art (fire<N>.webp); can be set later by the owner
PACK_IMAGE_BASE=
# Uniswap V2 router: buys the PLANK each sale burns
V2_ROUTER=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
# 70% of every pack sale. Nothing else lands here. (When the 30% PLANK burn swap can't run, that share goes to the
# PlankBurner the deploy creates: no owner, no withdraw, it can only buy PLANK and burn it.)
REVENUE_WALLET=
# PAPER wei per character suggestion to start (1e18 = 1 PAPER; 0 = free). The owner can change it later
# (FireCredits.setSuggestionRules). Every other sale number is set per drop (FireSale.configureDrop).
SUGGESTION_PAPER=1000000000000000000

# Step 6, per Series: script/ConfigureSeries.s.sol sends the studio's recipe JSON from the owner's hardware wallet:
# BATCH=A (content), then ops/series/verify-series.mjs (GREEN), then BATCH=B (configureDrop, the lock).
# SIMULATE=true with --fork-url runs them as the owner on a fork first (nothing sent).
# RECIPE_JSON=series/recipe.json   (must be under contracts/series/)
# BATCH=A
# DROP_START=      (unix seconds, batch B)
# HOLDER_ROOT=     (the snapshot's root, batch B)
# CHARACTER_BATCH=200
# RECIPE_DEALER, FIRE_CARDS, FIRE_SALE come from deployments/<chainId>.json
