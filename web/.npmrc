# Exact versions only (npm install --save writes "1.2.3", never "^1.2.3"), and a new release waits 7 days
# before it can be installed (npm 11.10 and later; older npm ignores the line, so check `npm -v`). A reviewed
# security fix can skip the wait: npm install <pkg>@<ver> --min-release-age=0
save-exact=true
min-release-age=7
