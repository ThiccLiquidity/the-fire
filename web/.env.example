# Copy to .env.local for dev; set the same names in Vercel (Project → Settings → Environment Variables).
# Everything VITE_* is bundled into the public site — never put a secret or a paid RPC key here.
# testnet = Robinhood Chain testnet (46630); empty = mainnet.
VITE_CHAIN=
# Optional. Leave empty to read through the public Robinhood RPC. If set, its host MUST also be added to connect-src in
# web/vercel.json, or the browser blocks every read on the live site; the production build fails if it's missing.
VITE_RPC_URL=
# For later (the site doesn't connect wallets yet). Reown (WalletConnect) project id: public, not a secret. Free at
# https://dashboard.reown.com; allow the site's domains. Used by the wallet bundle (npm run build:wallet); see README.
VITE_REOWN_PROJECT_ID=
