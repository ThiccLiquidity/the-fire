# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Environment (keep the examples)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local tool settings
.claude/settings.local.json

# Ops: generated files (rehearsal and test outputs)
contracts/series/rehearsal-*.json
deployments/rehearsal-*.json
deployments/test-*.json
deployments/31337.json
ops/rehearsal/out/
# the Series launcher's state and logs (ops/series/launch.mjs)
ops/series/out/
# a deploy waiting to be recorded (ops/deploy/record.mjs)
deployments/*.pending

# Never commit: keys, keystores, IPFS CAR files (kept offline), holder snapshots
*.car
**/keystores/
*.keystore
*.pem
*.key
ops/**/*-holders.json
contracts/series/*-holders.json
ops/keeper/.keeper-state.json

# the live chain layer's local test (web/scripts/chain-test)
web/scripts/chain-test/out/
web/dist-chaintest/

# the Forge wallet bundle: built by npm run build:wallet (local) and by npm run build into dist (the deploy)
web/art/factory/forge/vendor/
web/public/forge/vendor/
web/scripts/forge-e2e/shots/
web/scripts/press-e2e/shots/

# Served copy of the Forge: made by web/art/factory/sync_forge.sh (runs before every build)
web/public/forge/
