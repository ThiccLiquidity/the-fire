# The Morning Wood pipeline. Copy to paper/.env (git-ignored) or set in the scheduled task's environment.
# Never paste keys in chat; never commit .env.

# X posts (TwitterAPI.io). Unset = mock posts (marked mock in the news pack).
TWITTERAPI_IO_KEY=

# Images. IMAGE_PROVIDER = openai (any OpenAI-compatible /v1/images/generations) | none (placeholders)
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium

# Imgflip captions (free account). Unset = meme placeholders (template + caption text, rendered by the site).
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# IPFS (Pinata JWT, scoped to pinning only).
PINATA_JWT=

# Chain reads (markets, letters, site events). Public RPC works but is rate-limited; Alchemy is better.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_API=https://robinhoodchain.blockscout.com/api/v2
CHAIN_ID=4663

# Publishing: the editor key lives in the Foundry keystore (cast wallet import editor --interactive), never here.
EDITOR_ACCOUNT=editor
# When the issue opens, local hour (America/New_York) the morning after it's written.
OPENS_HOUR=6
PREVIEW_BASE=https://YOUR-SITE/press/preview
